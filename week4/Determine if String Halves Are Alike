class Solution {
    public boolean halvesAreAlike(String s) {
        String vowels = "aeiouAEIOU";
        int balance = 0;
        int mid = s.length() / 2;
        for (int i = 0; i < mid; i++) {
            if (vowels.indexOf(s.charAt(i)) != -1) {
                balance++;
            }
            if (vowels.indexOf(s.charAt(mid + i)) != -1) {
                balance--;
            }
        }        
        return balance == 0;
    }
}
