import java.io.*;
import java.util.*;
public class Solution {
    static int[] manacher(int[] a) {
        int n = a.length;
        int[] radius = new int[n];
        int center = 0;
        int right = 0;
        for (int i = 0; i < n; i++) {
            if (i < right) {
                int mirror = 2 * center - i;
                radius[i] = Math.min(right - i, radius[mirror]);
            } else {
                radius[i] = 0;
            }
            while (i - radius[i] - 1 >= 0
                    && i + radius[i] + 1 < n
                    && a[i - radius[i] - 1] == a[i + radius[i] + 1]) {
                radius[i]++;
            }
            if (i + radius[i] > right) {
                center = i;
                right = i + radius[i];
            }
        }
        return radius;
    }
    static class SparseTable {
        int[][] table;
        int[] log;
        SparseTable(int[] a) {
            int n = a.length;
            log = new int[n + 1];
            for (int i = 2; i <= n; i++) {
                log[i] = log[i / 2] + 1;
            }
            int levels = log[n] + 1;
            table = new int[levels][n];
            System.arraycopy(a, 0, table[0], 0, n);
            for (int k = 1; k < levels; k++) {
                int len = 1 << k;
                int half = len >> 1;
                for (int i = 0; i + len <= n; i++) {
                    table[k][i] = Math.max(
                            table[k - 1][i],
                            table[k - 1][i + half]
                    );
                }
            }
        }
        int query(int left, int right) {
            if (left > right) {
                return 0;
            }
            int len = right - left + 1;
            int k = log[len];
            return Math.max(
                    table[k][left],
                    table[k][right - (1 << k) + 1]
            );
        }
    }
    public static void main(String[] args) throws Exception {
        BufferedReader br = new BufferedReader(
                new InputStreamReader(System.in)
        );
        int n = Integer.parseInt(br.readLine().trim());
        String s = br.readLine().trim();
        String doubled = s + s;
        int m = 4 * n + 1;
        int[] transformed = new int[m];
        for (int i = 0; i < m; i++) {
            if ((i & 1) == 0) {
                // Separator
                transformed[i] = 0;
            } else {
                // Characters are 1..26
                transformed[i] = doubled.charAt(i / 2) - 'a' + 1;
            }
        }
        int[] radius = manacher(transformed);
        SparseTable st = new SparseTable(radius);
        StringBuilder out = new StringBuilder();
        for (int k = 0; k < n; k++) {
            int L = 2 * k + 1;
            int R = 2 * (k + n - 1) + 1;
            int low = 1;
            int high = n;
            int answer = 1;
            while (low <= high) {
                int len = (low + high) >>> 1;            
                int leftCenter = L + len - 1;
                int rightCenter = R - len + 1;
                int maxRadius = st.query(
                        leftCenter,
                        rightCenter
                );
                if (maxRadius >= len) {
                    answer = len;
                    low = len + 1;
                } else {
                    high = len - 1;
                }
            }
            out.append(answer).append('\n');
        }
        System.out.print(out);
    }
}
